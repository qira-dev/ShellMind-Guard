{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "shellmind-guard hook claude-pre-commit",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
